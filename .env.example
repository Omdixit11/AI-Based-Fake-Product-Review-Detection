# Copy values into frontend/.env.local (frontend) and backend/.env (backend) as needed.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Phase 1-3: true (frontend uses mock data). Phase 4 onward: false (real API).
NEXT_PUBLIC_USE_MOCK=true
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./history.db

# --- Phase 3.5 optional backend features (see docs/ADVANCED_FEATURES.md) ---
# Each switch only adds new optional response fields; false = exact Phase 3 shape.
ENABLE_TIER1=true
ENABLE_SARCASM=true
# Tier-1 rule filter (in-memory, per server process)
TIER1_MAX_REVIEWS_PER_MINUTE=5
TIER1_DUPLICATE_THRESHOLD=3
TIER1_MIN_WORDS=4
TIER1_VELOCITY_WINDOW_SECONDS=60
TIER1_DUPLICATE_WINDOW_SECONDS=600
TIER1_MAX_TRACKED_KEYS=2000
# Sarcasm contrast score (0-1) needed before SARCASM_SUSPECTED is raised
SARCASM_THRESHOLD=0.6
# POST /api/explain: SHAP for the linear SVM. Needs `pip install shap`
# (see backend/requirements-advanced.txt). Falls back to the identical
# direct computation, labelled "linear-coefficients", when false or missing.
ENABLE_SHAP=true
